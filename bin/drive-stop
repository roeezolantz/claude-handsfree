#!/bin/bash
# Stops any running hands-free listener (wispr-turn) and resets Wispr's Fn toggle.
set -u
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BIN="${HANDSFREE_BIN:-$SCRIPT_DIR}"
STATE_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/claude-handsfree"
PID_FILE="$STATE_DIR/listener.pid"

if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
  echo "drive-stop: kills any running wispr-turn listener and resets Wispr's Fn toggle (tap)."
  exit 0
fi

if [ -f "$PID_FILE" ]; then
  pid="$(cat "$PID_FILE" 2>/dev/null || true)"
  # shortcut: pid could in rare cases be recycled after wispr-turn exited naturally; kill -0 makes that safe to skip.
  if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
    kill "$pid" 2>/dev/null
  fi
  rm -f "$PID_FILE"
fi
"$BIN/wispr-handsfree" tap >/dev/null
